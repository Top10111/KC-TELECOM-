# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://kc_user:kc_password@localhost:5432/kc_telecom?schema=public"

# JWT
JWT_SECRET="change-this-to-a-long-random-secret"
JWT_EXPIRES_IN="1d"

# Bootstrap admin (created by prisma/seed.ts on first run)
ADMIN_EMAIL="admin@kctelecom.com"
ADMIN_PHONE="08000000000"
ADMIN_PASSWORD="ChangeMe123!"

# Postgres container credentials (used by docker-compose.yml; must match
# the credentials embedded in DATABASE_URL above when using Docker)
POSTGRES_USER="kc_user"
POSTGRES_PASSWORD="change-this-password"
POSTGRES_DB="kc_telecom"

# Frontend build-time API URL (used by docker-compose.yml when building the
# frontend image; see frontend/.env.example for the non-Docker equivalent)
VITE_API_BASE_URL="http://localhost:3000/api/v1"
