generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  VENDOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum Network {
  MTN
  GLO
  AIRTEL
  NINE_MOBILE
}

enum WalletTxType {
  FUNDING
  DEBIT
  REFUND
}

enum WalletTxStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PinStatus {
  AVAILABLE
  SOLD
}

enum PurchaseStatus {
  COMPLETED
  FAILED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  phone         String    @unique
  fullName      String
  businessName  String?
  passwordHash  String
  role          Role      @default(VENDOR)
  status        UserStatus @default(ACTIVE)

  wallet        Wallet?
  purchases     PinPurchase[]
  batchesCreated PinBatch[] @relation("CreatedBatches")

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model Wallet {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  balance       Decimal  @default(0) @db.Decimal(14, 2)
  transactions  WalletTransaction[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("wallets")
}

model WalletTransaction {
  id            String         @id @default(uuid())
  walletId      String
  wallet        Wallet         @relation(fields: [walletId], references: [id])
  type          WalletTxType
  amount        Decimal        @db.Decimal(14, 2)
  balanceBefore Decimal        @db.Decimal(14, 2)
  balanceAfter  Decimal        @db.Decimal(14, 2)
  reference     String         @unique
  status        WalletTxStatus @default(PENDING)
  description   String?

  createdAt     DateTime       @default(now())

  @@map("wallet_transactions")
}

model PinBatch {
  id                String        @id @default(uuid())
  batchLabel        String        @unique
  network           Network
  denomination      Decimal       @db.Decimal(10, 2)
  costPrice         Decimal       @db.Decimal(10, 2)
  sellingPrice      Decimal       @db.Decimal(10, 2)
  totalQuantity     Int
  availableQuantity Int

  createdById       String
  createdBy         User          @relation("CreatedBatches", fields: [createdById], references: [id])

  pins              RechargePin[]
  purchases         PinPurchase[]

  createdAt         DateTime      @default(now())

  @@map("pin_batches")
}

model RechargePin {
  id           String       @id @default(uuid())
  batchId      String
  batch        PinBatch     @relation(fields: [batchId], references: [id])
  serialNumber String       @unique
  pinCode      String
  status       PinStatus    @default(AVAILABLE)

  purchaseId   String?
  purchase     PinPurchase? @relation(fields: [purchaseId], references: [id])
  soldAt       DateTime?

  createdAt    DateTime     @default(now())

  @@index([batchId, status])
  @@map("recharge_pins")
}

model PinPurchase {
  id           String         @id @default(uuid())
  vendorId     String
  vendor       User           @relation(fields: [vendorId], references: [id])
  batchId      String
  batch        PinBatch       @relation(fields: [batchId], references: [id])

  network      Network
  denomination Decimal        @db.Decimal(10, 2)
  quantity     Int
  unitPrice    Decimal        @db.Decimal(10, 2)
  unitCost     Decimal        @db.Decimal(10, 2)
  totalAmount  Decimal        @db.Decimal(14, 2)
  totalProfit  Decimal        @db.Decimal(14, 2)

  reference    String         @unique
  status       PurchaseStatus @default(COMPLETED)

  pins         RechargePin[]

  createdAt    DateTime       @default(now())

  @@map("pin_purchases")
}
